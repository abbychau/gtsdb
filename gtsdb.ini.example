[paths]
data = data

[listens]
http = 127.0.0.1:5556
tcp = 127.0.0.1:5555

[buffer]
; File handle LRU capacity (optional, default: 700)
; Controls how many file handles can be open simultaneously
; Lower values use less system resources but may impact performance
; file_handle_lru_capacity = 700

; Gorilla time-series compression during compaction (optional, default: false)
; When enabled, compacted AOF files are compressed using Facebook's Gorilla algorithm
; achieving ~8x space reduction with negligible read overhead (~85µs per 5000 points)
; compaction_compression = true

; Sync mode: "async" (default) or "sync"
; "async" = periodic background flush (better throughput, slight risk on crash)
; "sync"  = fsync after every write batch (safe but slower)
; sync_mode = async

; Sync interval in milliseconds for async mode (default: 500)
; Lower = less data loss on crash, higher = better throughput
; sync_interval_ms = 1000

[auth]
; User to use when no authentication is provided (optional, default: empty)
; If set (e.g. "root"), unauthenticated requests will be treated as this user
; no_auth_user = root

; Fixed token for the root user (optional)
; If set, the root user will always have this token
; root_token = your-secret-token

